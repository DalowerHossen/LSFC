# Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public production origin used in receipt QR codes (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://your-lsfc-domain.example

# Server-only. Never expose this value through NEXT_PUBLIC_*.
# Add only when a trusted admin workflow needs to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Private encrypted Google Drive storage for Owner signatures
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=service-account@project.iam.gserviceaccount.com
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_SIGNATURE_FOLDER_ID=your-private-drive-folder-id
# Generate 32 random bytes and encode as base64. Never expose with NEXT_PUBLIC_*.
SIGNATURE_ENCRYPTION_KEY=your-32-byte-base64-key

# Private encrypted application files. Root must be shared with the service account.
# The app creates Center_ID → Year → Month → Service folders under this root.
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-private-application-files-root-folder-id
# Use a separate 32-byte base64 key from the signature key.
FILE_ENCRYPTION_KEY=your-separate-32-byte-base64-key

# WhatsApp Cloud API (server-only)
WHATSAPP_CLOUD_API_TOKEN=your-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v21.0

# SMS fallback gateway (server-only; provider adapter uses these settings)
SMS_GATEWAY_URL=https://sms-provider.example/api/send
SMS_GATEWAY_API_KEY=your-api-key
SMS_SENDER_ID=LSFC
# Optional non-destructive provider health endpoint
SMS_GATEWAY_HEALTH_URL=https://sms-provider.example/api/health

# Trusted scheduler authentication. Generate at least 32 random bytes.
CRON_SECRET=replace-with-a-long-random-secret
# Reminder offsets require policy-owner approval; no default is assumed by the app.
# Comma-separated integers from 1 through 365, for example after formal approval: 90,30,7
LICENSE_REMINDER_DAYS=
